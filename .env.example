# Copy this file to `.env` and fill in the values below.
#   cp .env.example .env
# `.env` is gitignored — never commit real secrets.

# Postgres connection (matches the local Docker setup in docker-compose.yml).
# Leave as-is unless you point at a different database.
DATABASE_URL="postgresql://aem:aem_dev@localhost:5433/aem?schema=public"

# Auth.js session secret. Generate a real value with:
#   openssl rand -base64 32
AUTH_SECRET="generate-me-with-openssl-rand-base64-32"

# Google Gemini API key (algorithmic/AI features — Phase 4+). Optional until then.
GEMINI_API_KEY=""

# Shared secret for the scheduled risk recompute endpoint.
#   POST /api/cron/recompute  with  Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -base64 32
# Leave unset to disable scheduled recompute — the endpoint refuses to run
# rather than defaulting open. Example crontab entry (daily 02:00):
#   0 2 * * * curl -fsS -X POST http://localhost:3010/api/cron/recompute \
#               -H "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""


# ─── Production only (Docker / Dokploy) ─────────────────────────────────────
# Leave these unset for local development — `next dev` doesn't need them.
# See docs/AEM_Deployment.md.

# Canonical public URL. Auth.js v5 will NOT trust a proxied Host header unless
# AUTH_URL or AUTH_TRUST_HOST is set; behind Dokploy's Traefik, logins fail
# without them. Set both.
#   AUTH_URL="https://aem.example.com"
#   AUTH_TRUST_HOST="true"

# Postgres password for the compose stack (docker-compose.prod.yml builds
# DATABASE_URL from it). Generate with: openssl rand -base64 24
#   POSTGRES_PASSWORD=""

# Set to "false" to skip `prisma migrate deploy` on container start — e.g. when
# running migrations as a separate deploy step. Defaults to true.
#   RUN_MIGRATIONS="true"
